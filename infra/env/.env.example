# ==============================================================================
# TradiePulse Platform — Infrastructure Environment Configuration Example
# Target: https://tradiepulse.mainuddintalukdar.cloud
# ==============================================================================

DOMAIN_NAME=tradiepulse.mainuddintalukdar.cloud
ENVIRONMENT=production
NODE_ENV=production

# Modern Supabase Keys & OIDC JWKS
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_pub_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_sec_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://<your-project-id>.supabase.co/auth/v1/.well-known/jwks.json

# Aliases
SUPABASE_ANON_KEY=sb_pub_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=sb_sec_xxxxxxxxxxxxxxxxxxxxxxx

JWT_SIGNING_KEY=change-me-to-a-secure-256-bit-secret-key-at-least-32-chars-long
SUPERADMIN_EMAIL=admin@mainuddintalukdar.cloud
SUPERADMIN_PASSWORD=change-me-superadmin-secure-pwd-123!

RESEND_API_KEY=re_mock_resend_api_key_123456789
EMAIL_FROM_ADDRESS=noreply@mainuddintalukdar.cloud

OPENROUTER_API_KEY=sk-or-v1-mock-openrouter-key
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=gsk_mock_groq_api_key
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

GHCR_OWNER=qmainuddin
IMAGE_TAG=latest
