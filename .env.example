# ==============================================================================
# TradiePulse Platform — Environment Configuration Example (.env.example)
# Target: https://tradiepulse.mainuddintalukdar.cloud
# ==============================================================================

# --- Domain & Network ---
DOMAIN_NAME=tradiepulse.mainuddintalukdar.cloud
ENVIRONMENT=production
NODE_ENV=production

# --- Auth Service & Security ---
JWT_SIGNING_KEY=change-me-to-a-secure-256-bit-secret-key-at-least-32-chars-long
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
SUPERADMIN_EMAIL=admin@mainuddintalukdar.cloud
SUPERADMIN_PASSWORD=change-me-superadmin-secure-pwd-123!
GOOGLE_OAUTH_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=mock-google-client-secret
CONFIG_SERVER_ENCRYPT_KEY=change-me-config-server-master-cipher-key-32c

# --- Modern Supabase Connection (Publishable Key, Secret Key, JWKS URL) ---
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_pub_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_sec_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://<your-project-id>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=tradiepulse-media

# Backward compatibility aliases
SUPABASE_ANON_KEY=sb_pub_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=sb_sec_xxxxxxxxxxxxxxxxxxxxxxx

# --- Database (Postgres + PostGIS) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tradiepulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/tradiepulse

# --- In-Memory & Caching (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# --- Vector Store (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- Async Message Broker (RabbitMQ) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- LLM Providers (Free / Multi-Model Router & Fallback) ---
OPENROUTER_API_KEY=sk-or-v1-mock-openrouter-key
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=gsk_mock_groq_api_key
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_PER_REQUEST_TOKEN_CEILING=4096
LLM_MAX_TOOL_CALLS_PER_TURN=5
LLM_TIMEOUT_SECONDS=30

# --- Email Provider (Resend) ---
RESEND_API_KEY=re_mock_resend_api_key_123456789
EMAIL_FROM_ADDRESS=noreply@mainuddintalukdar.cloud
EMAIL_ACTIVATION_EXPIRES_HOURS=48

# --- Hostinger Deployment & Container Registry ---
GHCR_OWNER=qmainuddin
IMAGE_TAG=latest
HOSTINGER_SSH_HOST=72.62.70.145
HOSTINGER_SSH_USER=root
HOSTINGER_SSH_KEY=
HOSTINGER_SSH_PASSWORD=
